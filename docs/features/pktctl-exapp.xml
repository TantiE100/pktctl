<?xml version="1.0" encoding = "iso-8859-1"?>
<!DOCTYPE PT_APP_META>
<PT_APP_META>
    <PT_VERSION>9.0.0</PT_VERSION>
    <IPC_VERSION>1.0</IPC_VERSION>
    <NAME>pktctl</NAME>
    <VERSION>0.1.0</VERSION>
    <ID>dev.pktctl</ID>
    <DESCRIPTION>MCP server that drives Packet Tracer over PTMP</DESCRIPTION>
